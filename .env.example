# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=

# Model names live in config so they can change without code edits.
# Verify current names in the Anthropic docs before relying on these defaults.
CANIRUNIT_PARSER_MODEL=claude-haiku-4-5
CANIRUNIT_RESOLVER_MODEL=claude-haiku-4-5
CANIRUNIT_SEARCH_MODEL=claude-sonnet-4-6
CANIRUNIT_TIPS_MODEL=claude-haiku-4-5

# HTTP/LLM response cache TTL in hours (cache is safe to delete).
CANIRUNIT_CACHE_TTL_HOURS=24

# Optional: override the cache folder (default: user app-data folder).
# CANIRUNIT_CACHE_DIR=
