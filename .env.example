# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=

# Model names live in config so they can change without code edits.
# Verify current names in the Anthropic docs before relying on these defaults.
WHATCANMYCOMPUTERRUN_PARSER_MODEL=claude-haiku-4-5
WHATCANMYCOMPUTERRUN_RESOLVER_MODEL=claude-haiku-4-5
WHATCANMYCOMPUTERRUN_SEARCH_MODEL=claude-sonnet-4-6
WHATCANMYCOMPUTERRUN_TIPS_MODEL=claude-haiku-4-5

# HTTP/LLM response cache TTL in hours (cache is safe to delete).
WHATCANMYCOMPUTERRUN_CACHE_TTL_HOURS=24

# Optional: override the cache folder (default: user app-data folder).
# WHATCANMYCOMPUTERRUN_CACHE_DIR=

# Optional second AI provider (free tier): Gemini. With no ANTHROPIC key set, the app uses this.
# Release builds can bake a key in (see build/build.ps1); a key here overrides it.
GEMINI_API_KEY=
# WHATCANMYCOMPUTERRUN_LLM_PROVIDER=auto   # auto | anthropic | gemini
# WHATCANMYCOMPUTERRUN_GEMINI_MODEL=gemini-3.5-flash-lite
